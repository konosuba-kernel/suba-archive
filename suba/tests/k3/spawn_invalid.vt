module test::program;
import suba::abi;
import suba::argument_wire;
import libsuba::services;
import libsuba::syscall;
import libsuba::argument_builder;
import test::common;
static mut ARGS: [4096]u8 = zero;
unsafe fn run_pair(pair: services::StreamPair) -> u32 {
    unsafe {
        if !argument_builder::initialize(core::slice_of_mut(ARGS), "/boot") ||
            !argument_builder::append(core::slice_of_mut(ARGS), "sleep") { return 121; }
        ARGS[52_usize] = 1; // Reserved header bytes must be zero.
        let bad: syscall::Reply = services::spawn("1", core::slice_of(ARGS), 0, 0, 0);
        if bad.status != abi::INVALID { return 122; }
        ARGS[52_usize] = 0;
        let missing: syscall::Reply = services::spawn("/boot/7", core::slice_of(ARGS), 0, 0, 0);
        if missing.status != abi::NOT_FOUND { return 123; }
        let wrong: syscall::Reply = services::spawn("1", core::slice_of(ARGS), pair.read, 0, 0);
        if wrong.status != abi::DENIED { return 124; }
        // First inherited writer is retained before the second invalid endpoint fails.
        let partial: syscall::Reply = services::spawn("1", core::slice_of(ARGS), pair.write, pair.read, 0);
        if partial.status != abi::DENIED { return 125; }
        let close: syscall::Reply = syscall::close(pair.write);
        if close.status != abi::OK { return 126; }
        var one: [1]u8 = zero;
        let eof: syscall::Reply = services::read(pair.read, core::slice_of_mut(one), false);
        if eof.status != abi::OK || eof.value != 0_usize { return 127; }
        let child: syscall::Reply = common::spawn("sleep", 0, 0, 0);
        if child.status != abi::OK { return 128; }
        let killed: syscall::Reply = syscall::kill_child(child.value);
        if killed.status != abi::OK || !common::collect(child.value, abi::CANCELLED) { return 129; }
        let end: syscall::Reply = syscall::close(pair.read);
        if end.status != abi::OK { return 130; }
        return 0;
    }
}
pub fn run() -> u32 {
    match services::streams() {
        services::Streams::Failed(status) => { return 120; },
        services::Streams::Ready(pair) => { unsafe { return run_pair(pair); } }
    }
}
