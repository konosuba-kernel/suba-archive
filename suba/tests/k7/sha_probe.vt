module test::sha;
import user::build::sha256;
import test::transport;
static mut INPUT: [1048577]u8 = zero;
pub fn run() -> u32 {
    var state: sha256::State = sha256::begin();
    var output: [32]u8 = zero;
    unsafe {
        let count: usize = transport::read(core::slice_of_mut(INPUT));
        if count == 0_usize || count > 1048576_usize { return 80; }
        let chunk: usize = INPUT[0] as usize + 1_usize;
        var at: usize = 1;
        while at < count {
            var size: usize = count - at;
            if size > chunk { size = chunk; }
            let bytes: []const u8 = core::slice_from_raw_parts(core::ptr_add(core::slice_of(INPUT).data, at), size);
            if !sha256::update(core::addr_of_mut(state), bytes) { return 81; }
            at = at + size;
        }
        if sha256::finish(core::addr_of_mut(state), core::slice_from_raw_parts_mut(core::slice_of_mut(output).data, 31)) { return 82; }
        if !sha256::finish(core::addr_of_mut(state), core::slice_of_mut(output)) { return 83; }
        if sha256::finish(core::addr_of_mut(state), core::slice_of_mut(output)) { return 84; }
        if sha256::update(core::addr_of_mut(state), "") { return 85; }
        if !transport::write(core::slice_of(output)) { return 86; }
    }
    return 0;
}
