// K3 assertions migrated unchanged into a current FS-loaded ordinary process.
module test::k10_memory;
import suba::abi;
import suba::syscalls;
import libsuba::syscall;
import libsuba::services;
pub fn run() -> u32 {
    let baseline: syscall::Reply = services::stats(syscalls::STATS_FREE_PAGES);
    var cycle: usize = 0;
    while cycle < 128_usize {
        let pages: syscall::Reply = services::allocate_pages(2);
        if pages.status != abi::OK || pages.value != abi::USER_PAGES_BASE { return 10; }
        unsafe {
            if *core::ptr::<usize>(pages.value) != 0_usize || *core::ptr::<usize>(pages.value + 8192_usize - 8_usize) != 0_usize { return 11; }
            *core::ptr::<usize>(pages.value) = 123;
        }
        let partial: syscall::Reply = services::free_pages(pages.value, 1);
        if partial.status != abi::INVALID { return 12; }
        unsafe { if *core::ptr::<usize>(pages.value) != 123_usize { return 13; } }
        let released: syscall::Reply = services::free_pages(pages.value, 2);
        let repeated: syscall::Reply = services::free_pages(pages.value, 2);
        if released.status != abi::OK || repeated.status != abi::INVALID { return 14; }
        let current: syscall::Reply = services::stats(syscalls::STATS_FREE_PAGES);
        if current.value != baseline.value { return 15; }
        cycle = cycle + 1_usize;
    }
    // Cross a 2 MiB leaf-table boundary and demand both empty table pages return.
    let large: syscall::Reply = services::allocate_pages(513);
    if large.status != abi::OK { return 16; }
    unsafe { *core::ptr::<usize>(large.value + 512_usize * 4096_usize) = 987; }
    let freed: syscall::Reply = services::free_pages(large.value, 513);
    let end: syscall::Reply = services::stats(syscalls::STATS_FREE_PAGES);
    if freed.status != abi::OK || end.value != baseline.value { return 17; }
    let overflow: syscall::Reply = services::allocate_pages(0xffffffffffffffff);
    if overflow.status != abi::INVALID { return 18; }
    return 0;
}
