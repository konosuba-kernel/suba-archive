// Native build job wire interface. Caller owns Job and ends/closes it on all exits.
module libsuba::job_api;
import suba::abi;
import suba::files;
import suba::argument_wire;
import libsuba::syscall;
pub struct Job { pub handle: usize, path: [files::JOB_PATH_MAX]u8, length: usize,
    pub boot_id: usize, pub source_epoch: usize }
pub enum Created { Ready(Job), Failed(usize) }
pub fn create() -> Created {
    var record: [files::JOB_INFO_BYTES]u8 = zero;
    let result: syscall::Reply = syscall::invoke(abi::SYS_JOB_CREATE,
        core::addr(core::slice_of_mut(record).data), files::JOB_INFO_BYTES, 0, 0, 0, 0);
    if result.status != abi::OK { return Created::Failed(result.status); }
    // SAFETY: kernel filled this exact local record; copy path into owned storage.
    unsafe {
        let data: []const u8 = core::slice_of(record);
        let length: usize = argument_wire::word(data, files::JOB_PATH_BYTES, 4);
        if argument_wire::word(data, 0, 4) != abi::VERSION as usize ||
            argument_wire::word(data, 4, 4) != files::JOB_INFO_BYTES ||
            length == 0_usize || length > files::JOB_PATH_MAX {
            let closed: syscall::Reply = syscall::close(result.value);
            return Created::Failed(abi::INVALID);
        }
        var job: Job = zero;
        job.handle = result.value;
        job.length = length;
        job.boot_id = argument_wire::word(data, files::JOB_BOOT_ID, 8);
        job.source_epoch = argument_wire::word(data, files::JOB_SOURCE_EPOCH, 8);
        var i: usize = 0;
        while i < length { job.path[i] = data[files::JOB_PATH + i]; i = i + 1_usize; }
        return Created::Ready(job);
    }
}
// Borrow expires when owner Job is moved or destroyed; do not pass by value.
pub unsafe fn path(job: *const Job) -> []const u8 {
    unsafe { return core::slice_from_raw_parts(core::slice_of((*job).path).data, (*job).length); }
}
pub fn freeze(job: Job) -> syscall::Reply {
    return syscall::invoke(abi::SYS_JOB_FREEZE, job.handle, job.source_epoch, job.boot_id, 0, 0, 0);
}
pub fn end(job: Job) -> syscall::Reply {
    return syscall::invoke(abi::SYS_JOB_END, job.handle, 0, 0, 0, 0, 0);
}
