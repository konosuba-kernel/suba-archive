// Streaming SHA-256 for build input records. No I/O or implicit allocation.
module user::build::sha256;
pub struct State { words: [8]u32, block: [64]u8, used: usize, bytes: usize, done: bool }
static K: [64]u32 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
];
pub fn begin() -> State {
    var state: State = zero;
    state.words = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    return state;
}
fn rotate(value: u32, bits: u32) -> u32 { return (value >> bits) | (value << (32_u32 - bits)); }

unsafe fn compress(state: *State) -> () {
    var words: [64]u32 = zero;
    // SAFETY: valid exclusive State; all block/schedule indices fit their fixed arrays.
    // SHA-256 deliberately uses modular 32-bit sums throughout this transform.
    unsafe {
        var i: usize = 0;
        while i < 16_usize {
            let offset: usize = i * 4_usize;
            words[i] = ((*state).block[offset] as u32) << 24_u32 |
                ((*state).block[offset + 1_usize] as u32) << 16_u32 |
                ((*state).block[offset + 2_usize] as u32) << 8_u32 |
                ((*state).block[offset + 3_usize] as u32);
            i = i + 1_usize;
        }
        while i < 64_usize {
            let x: u32 = words[i - 15_usize];
            let y: u32 = words[i - 2_usize];
            let s0: u32 = rotate(x, 7) ^ rotate(x, 18) ^ (x >> 3_u32);
            let s1: u32 = rotate(y, 17) ^ rotate(y, 19) ^ (y >> 10_u32);
            words[i] = words[i - 16_usize] +% s0 +% words[i - 7_usize] +% s1;
            i = i + 1_usize;
        }
        var a: u32 = (*state).words[0]; var b: u32 = (*state).words[1];
        var c: u32 = (*state).words[2]; var d: u32 = (*state).words[3];
        var e: u32 = (*state).words[4]; var f: u32 = (*state).words[5];
        var g: u32 = (*state).words[6]; var h: u32 = (*state).words[7];
        i = 0;
        while i < 64_usize {
            let s1: u32 = rotate(e, 6) ^ rotate(e, 11) ^ rotate(e, 25);
            let choose: u32 = (e & f) ^ ((e ^ 0xffffffff_u32) & g);
            let first: u32 = h +% s1 +% choose +% K[i] +% words[i];
            let s0: u32 = rotate(a, 2) ^ rotate(a, 13) ^ rotate(a, 22);
            let majority: u32 = (a & b) ^ (a & c) ^ (b & c);
            let second: u32 = s0 +% majority;
            h = g; g = f; f = e; e = d +% first;
            d = c; c = b; b = a; a = first +% second;
            i = i + 1_usize;
        }
        (*state).words[0] = (*state).words[0] +% a; (*state).words[1] = (*state).words[1] +% b;
        (*state).words[2] = (*state).words[2] +% c; (*state).words[3] = (*state).words[3] +% d;
        (*state).words[4] = (*state).words[4] +% e; (*state).words[5] = (*state).words[5] +% f;
        (*state).words[6] = (*state).words[6] +% g; (*state).words[7] = (*state).words[7] +% h;
        (*state).used = 0;
    }
    return ();
}

// Caller exclusively owns a State from begin(), retains bytes for this synchronous
// call, and must not overlap data with State. O(bytes), preemptible user-mode work.
pub unsafe fn update(state: *State, data: []const u8) -> bool {
    unsafe {
        if (*state).done || data.len > 0x1fffffffffffffff_usize - (*state).bytes { return false; }
        (*state).bytes = (*state).bytes + data.len;
        var i: usize = 0;
        while i < data.len {
            (*state).block[(*state).used] = data[i];
            (*state).used = (*state).used + 1_usize;
            if (*state).used == 64_usize { compress(state); }
            i = i + 1_usize;
        }
    }
    return true;
}

// Finalization consumes State. Output is exactly 32 writable non-overlapping bytes.
pub unsafe fn finish(state: *State, output: []u8) -> bool {
    unsafe {
        if (*state).done || output.len != 32_usize { return false; }
        (*state).block[(*state).used] = 128;
        (*state).used = (*state).used + 1_usize;
        if (*state).used > 56_usize {
            while (*state).used < 64_usize {
                (*state).block[(*state).used] = 0;
                (*state).used = (*state).used + 1_usize;
            }
            compress(state);
        }
        while (*state).used < 56_usize {
            (*state).block[(*state).used] = 0;
            (*state).used = (*state).used + 1_usize;
        }
        let bits: usize = (*state).bytes * 8_usize;
        var i: usize = 0;
        while i < 8_usize {
            (*state).block[56_usize + i] = (bits >> ((7_usize - i) * 8_usize)) as u8;
            i = i + 1_usize;
        }
        compress(state);
        i = 0;
        while i < 32_usize {
            output[i] = ((*state).words[i / 4_usize] >> (((3_usize - i % 4_usize) * 8_usize) as u32)) as u8;
            i = i + 1_usize;
        }
        (*state).done = true;
    }
    return true;
}
