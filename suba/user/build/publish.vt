// Build worker publishes only a complete sealed ELF. A stable read lease protects
// the exact bytes being validated. Build records are addressed by their own full SHA-256.
module user::build::publish;
import suba::abi;
import suba::image;
import suba::files;
import libsuba::files as fs;
import libsuba::job_api;
import libsuba::syscall;
import user::build::io;
import user::build::sha256;
import user::build::records;
static mut ELF: [16777217]u8 = zero;
static mut PATH: [255]u8 = zero;
static mut TEMP: [255]u8 = zero;
static mut RECORD_PATH: [128]u8 = zero;
static mut RECORD: [33024]u8 = zero;
static mut STORED: [33025]u8 = zero;

unsafe fn record_path(digest: []const u8) -> []const u8 {
    var encoded: [64]u8 = zero;
    unsafe {
        if !records::hex(core::slice_of_mut(encoded), digest) { return ""; }
        var writer: records::Writer = records::begin(core::slice_of_mut(RECORD_PATH));
        if !records::text(core::addr_of_mut(writer), "/work/.suba-records/") ||
            !records::text(core::addr_of_mut(writer), core::slice_from_raw_parts(core::slice_of(encoded).data, 32)) ||
            !records::text(core::addr_of_mut(writer), "/") ||
            !records::text(core::addr_of_mut(writer), core::slice_from_raw_parts(core::ptr_add(core::slice_of(encoded).data, 32), 32)) {
            return "";
        }
        return records::bytes(core::addr_of(writer));
    }
}

// An existing content-addressed record is accepted only when every byte agrees.
// Failure never replaces a preexisting name owned by another operation.
unsafe fn preserve_record(path: []const u8, bytes: []const u8) -> usize {
    unsafe {
        let status: usize = io::directories(path, 6);
        if status != abi::OK { return status; }
        let saved: usize = io::save_new(path, bytes, true);
        if saved != abi::EXISTS { return saved; }
        var count: usize = 0;
        match io::read(path, core::slice_of_mut(STORED)) {
            io::Read::Failed(error) => { return error; },
            io::Read::Ready(value) => { count = value; }
        }
        if count != bytes.len { return abi::EXISTS; }
        var i: usize = 0;
        while i < count {
            if STORED[i] != bytes[i] { return abi::EXISTS; }
            i = i + 1_usize;
        }
    }
    return abi::OK;
}
unsafe fn temp_path(job: *const job_api::Job, destination: []const u8) -> []const u8 {
    unsafe {
        var parent: usize = 0;
        var i: usize = 0;
        while i < destination.len {
            if destination[i] == 47_u8 { parent = i + 1_usize; }
            i = i + 1_usize;
        }
        let root: []const u8 = job_api::path(job);
        if root.len <= 6_usize { return ""; }
        var writer: records::Writer = records::begin(core::slice_of_mut(TEMP));
        if !records::text(core::addr_of_mut(writer), core::slice_from_raw_parts(destination.data, parent)) ||
            !records::text(core::addr_of_mut(writer), ".suba-") ||
            !records::text(core::addr_of_mut(writer), core::slice_from_raw_parts(core::ptr_add(root.data, 6), root.len - 6_usize)) ||
            !records::text(core::addr_of_mut(writer), ".tmp") { return ""; }
        return records::bytes(core::addr_of(writer));
    }
}

// Only one worker invokes this owner. Input notes stay live until return. The
// successful REPLACE is the publication point; cancellation after it cannot undo
// the published artifact. Before it, Transient remains owned by this process.
pub unsafe fn result(job: *const job_api::Job, destination: []const u8,
    kernel: bool, notes: []const u8) -> usize {
    unsafe {
        let source: []const u8 = io::join(core::slice_of_mut(PATH), job_api::path(job), "/out/result.elf");
        if source.len == 0_usize { return abi::LIMIT; }
        var count: usize = 0;
        match io::read(source, core::slice_of_mut(ELF)) {
            io::Read::Failed(error) => { return error; },
            io::Read::Ready(bytes) => { count = bytes; }
        }
        let bytes: []const u8 = core::slice_from_raw_parts(core::slice_of(ELF).data, count);
        match image::inspect(bytes, bytes.len, kernel) {
            image::Inspect::Invalid => { return abi::INVALID; }, image::Inspect::Ready(plan) => {}
        }
        var writer: records::Writer = records::begin(core::slice_of_mut(RECORD));
        if !records::text(core::addr_of_mut(writer), notes) ||
            !records::input(core::addr_of_mut(writer), 0, destination, bytes) { return abi::LIMIT; }
        var hash: sha256::State = sha256::begin();
        var digest: [32]u8 = zero;
        if !sha256::update(core::addr_of_mut(hash), records::bytes(core::addr_of(writer))) ||
            !sha256::finish(core::addr_of_mut(hash), core::slice_of_mut(digest)) { return abi::LIMIT; }
        let identity: []const u8 = record_path(core::slice_of(digest));
        if identity.len == 0_usize { return abi::LIMIT; }
        var status: usize = preserve_record(identity, records::bytes(core::addr_of(writer)));
        if status != abi::OK { return status; }
        let temporary: []const u8 = temp_path(job, destination);
        if temporary.len == 0_usize { return abi::LIMIT; }
        status = io::directories(destination, 0);
        if status != abi::OK { return status; }
        status = io::save_new(temporary, bytes, false);
        if status != abi::OK { return status; }
        status = fs::replace(temporary, destination).status;
        if status != abi::OK {
            // Still a caller-owned Transient if replacement did not commit.
            let removed: syscall::Reply = fs::unlink(temporary);
            return status;
        }
        return fs::sync_all().status;
    }
}
