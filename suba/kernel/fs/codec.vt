// Explicit disk codec. Input views are borrowed, validated bytes, never struct casts.
module kernel::fs::codec;
import suba::abi;
import user::text::utf8;

pub struct Node {
    pub kind: u32, pub flags: u32, pub generation: usize, pub parent: u32,
    pub length: usize, pub bytes: usize, pub first: u32, pub last: u32,
    pub name: [63]u8,
}
pub enum NodeRead { Invalid, Value(Node) }
pub const ROOT: usize = 0;
pub const TRANSIENT: u32 = 1;
pub const DETACHED: u32 = 2;

// All accesses below use a caller-checked record of at least 128 bytes (super: 4096).
unsafe fn word(data: []const u8, at: usize, width: usize) -> usize {
    var value: usize = 0; var i: usize = 0;
    unsafe { while i < width { value = value | ((data[at + i] as usize) << (i * 8_usize)); i = i + 1_usize; } }
    return value;
}
unsafe fn put(data: []u8, at: usize, width: usize, value: usize) -> () {
    var i: usize = 0;
    unsafe { while i < width { data[at + i] = (value >> (i * 8_usize)) as u8; i = i + 1_usize; } }
    return ();
}
unsafe fn zeros(data: []const u8, begin: usize, end: usize) -> bool {
    var i: usize = begin;
    unsafe { while i < end { if data[i] != 0_u8 { return false; } i = i + 1_usize; } }
    return true;
}
// IEEE reflected CRC32; checksum field is treated as zero without mutating input.
pub unsafe fn checksum(data: []const u8, skip: usize, count: usize) -> u32 {
    var crc: u32 = 0xffffffff; var i: usize = 0;
    unsafe {
        while i < data.len {
            var byte: u32 = 0;
            if i < skip || i - skip >= count { byte = data[i] as u32; }
            crc = crc ^ byte;
            var bit: usize = 0;
            while bit < 8_usize {
                let low: u32 = crc & 1_u32; crc = crc >> 1_u32;
                if low != 0_u32 { crc = crc ^ 0xedb88320_u32; }
                bit = bit + 1_usize;
            }
            i = i + 1_usize;
        }
    }
    return crc ^ 0xffffffff_u32;
}
pub unsafe fn super_valid(data: []const u8) -> bool {
    if data.len != abi::BLOCK_BYTES { return false; }
    unsafe {
        if word(data, 0, 8) != abi::FS_MAGIC_VALUE { return false; }
        if word(data, 8, 4) != abi::VERSION as usize { return false; }
        if word(data, 12, 4) != abi::BLOCK_BYTES { return false; }
        if word(data, 16, 4) != abi::FS_BLOCKS { return false; }
        if word(data, 20, 4) != abi::FS_FAT_START { return false; }
        if word(data, 24, 4) != abi::FS_FAT_BLOCKS { return false; }
        if word(data, 28, 4) != abi::FS_NODES_START { return false; }
        if word(data, 32, 4) != abi::FS_NODE_COUNT { return false; }
        if word(data, 36, 4) != abi::FS_DATA_START { return false; }
        if word(data, 40, 4) != ROOT { return false; }
        if word(data, 44, 4) != checksum(data, 44, 4) as usize { return false; }
        return zeros(data, 56, data.len);
    }
}
pub unsafe fn super_write(data: []u8, boot_serial: usize) -> bool {
    if data.len != abi::BLOCK_BYTES { return false; }
    unsafe {
        var i: usize = 0;
        while i < data.len { data[i] = 0; i = i + 1_usize; }
        put(data, 0, 8, abi::FS_MAGIC_VALUE); put(data, 8, 4, abi::VERSION as usize);
        put(data, 12, 4, abi::BLOCK_BYTES); put(data, 16, 4, abi::FS_BLOCKS);
        put(data, 20, 4, abi::FS_FAT_START); put(data, 24, 4, abi::FS_FAT_BLOCKS);
        put(data, 28, 4, abi::FS_NODES_START); put(data, 32, 4, abi::FS_NODE_COUNT);
        put(data, 36, 4, abi::FS_DATA_START); put(data, 40, 4, ROOT);
        put(data, abi::FS_SUPER_BOOT_SERIAL, 8, boot_serial);
        let view: []const u8 = core::slice_from_raw_parts(data.data, data.len);
        put(data, 44, 4, checksum(view, 44, 4) as usize);
    }
    return true;
}
pub unsafe fn name_valid(name: []const u8) -> bool {
    if name.len == 0_usize || name.len > abi::NODE_NAME_MAX { return false; }
    unsafe {
        if name.len == 1_usize && name[0] == 46_u8 { return false; }
        if name.len == 2_usize && name[0] == 46_u8 && name[1] == 46_u8 { return false; }
        var i: usize = 0;
        while i < name.len { if name[i] == 0_u8 || name[i] == 47_u8 { return false; } i = i + 1_usize; }
        match utf8::validate(name) {
            utf8::Validation::Valid => { return true; },
            utf8::Validation::Invalid(offset) => { return false; },
        }
    }
}
pub fn data_block(value: u32) -> bool { return value >= abi::FS_DATA_START as u32 && value < abi::FS_BLOCKS as u32; }

// Record-local validation only. The mount walk checks ancestry, names and chain ownership.
pub unsafe fn node_read(data: []const u8, id: usize) -> NodeRead {
    if data.len != abi::FS_NODE_BYTES || id >= abi::FS_NODE_COUNT { return NodeRead::Invalid; }
    var node: Node = zero;
    unsafe {
        node.kind = word(data, 0, 4) as u32; node.flags = word(data, 4, 4) as u32;
        node.generation = word(data, 8, 8); node.parent = word(data, 16, 4) as u32;
        node.length = word(data, 20, 4); node.bytes = word(data, 24, 8);
        node.first = word(data, 32, 4) as u32; node.last = word(data, 36, 4) as u32;
        if node.kind == abi::NODE_FREE {
            if id == ROOT || node.flags != 0_u32 || !zeros(data, 16, 128) { return NodeRead::Invalid; }
            return NodeRead::Value(node);
        }
        if node.kind != abi::NODE_FILE && node.kind != abi::NODE_DIRECTORY { return NodeRead::Invalid; }
        if node.generation == 0_usize || node.parent >= abi::FS_NODE_COUNT as u32 { return NodeRead::Invalid; }
        if node.flags > 3_u32 || node.length > abi::NODE_NAME_MAX { return NodeRead::Invalid; }
        if !zeros(data, abi::NODE_NAME + node.length, 128) { return NodeRead::Invalid; }
        if id == ROOT {
            if node.kind != abi::NODE_DIRECTORY || node.parent != ROOT as u32 || node.length != 0_usize { return NodeRead::Invalid; }
        } else {
            let name: []const u8 = core::slice_from_raw_parts(core::ptr_add(data.data, abi::NODE_NAME), node.length);
            if !name_valid(name) { return NodeRead::Invalid; }
        }
        if node.kind == abi::NODE_DIRECTORY {
            if node.flags != 0_u32 || node.bytes != 0_usize || node.first != 0_u32 || node.last != 0_u32 { return NodeRead::Invalid; }
        } else {
            if node.bytes > abi::FS_FILE_BYTES_MAX { return NodeRead::Invalid; }
            if node.bytes == 0_usize {
                if node.first != 0_u32 || node.last != 0_u32 { return NodeRead::Invalid; }
            } else {
                if !data_block(node.first) || !data_block(node.last) { return NodeRead::Invalid; }
            }
        }
        var i: usize = 0;
        while i < node.length { node.name[i] = data[abi::NODE_NAME + i]; i = i + 1_usize; }
    }
    return NodeRead::Value(node);
}
// Internal Node must already satisfy record invariants; never encodes untrusted structs.
pub unsafe fn node_write(node: Node, data: []u8) -> bool {
    if data.len != abi::FS_NODE_BYTES || node.length > abi::NODE_NAME_MAX { return false; }
    unsafe {
        var i: usize = 0; while i < data.len { data[i] = 0; i = i + 1_usize; }
        put(data, 0, 4, node.kind as usize); put(data, 4, 4, node.flags as usize);
        put(data, 8, 8, node.generation); put(data, 16, 4, node.parent as usize);
        put(data, 20, 4, node.length); put(data, 24, 8, node.bytes);
        put(data, 32, 4, node.first as usize); put(data, 36, 4, node.last as usize);
        i = 0; while i < node.length { data[abi::NODE_NAME + i] = node.name[i]; i = i + 1_usize; }
    }
    return true;
}

// Caller has already validated this entire 4096-byte superblock.
pub unsafe fn boot_serial(data: []const u8) -> usize {
    unsafe { return word(data, abi::FS_SUPER_BOOT_SERIAL, 8); }
}
