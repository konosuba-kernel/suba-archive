// Borrowed framebuffer leaves are not allocator Frames. Only boot's Prepared
// desktop may call through process::prepare_display; normal map/free exclude it.
module kernel::space;
import kernel::device::display;
import suba::windows;

pub unsafe fn map_display_page(id: Id, page: usize) -> MappingResult {
    // SAFETY: physical range is the display owner's validated permanent BSS.
    unsafe {
        if !live(id) || page >= windows::SCREEN_PAGES { return MappingResult::Invalid; }
        let physical: usize = display::physical_base();
        if physical == 0_usize { return MappingResult::Invalid; }
        let address: usize = abi::DISPLAY_BASE + page * abi::PAGE_BYTES;
        let leaf: usize = table(RECORDS[id.slot].root, address, id.slot);
        if leaf == 0_usize {
            if !prune(id.slot, address) { return MappingResult::Invalid; }
            return MappingResult::NoMemory;
        }
        if *core::ptr::<usize>(leaf) != 0_usize { return MappingResult::Invalid; }
        *core::ptr::<usize>(leaf) = (((physical + page * abi::PAGE_BYTES) >> 12_usize)
            << 10_usize) | 215_usize;
        let index: usize = ((leaf & 0xfffffffffffff000_usize) - abi::RAM_BASE) / abi::PAGE_BYTES;
        PAGE_INFO[index].children = PAGE_INFO[index].children + 1_u32;
        return MappingResult::Ready(physical + page * abi::PAGE_BYTES);
    }
}

// Bootstrap rollback only: removes one borrowed leaf, never releases framebuffer RAM.
pub unsafe fn unmap_display_page(id: Id, page: usize) -> bool {
    unsafe {
        if !live(id) || page >= windows::SCREEN_PAGES { return false; }
        let address: usize = abi::DISPLAY_BASE + page * abi::PAGE_BYTES;
        var node: usize = RECORDS[id.slot].root;
        var shift: usize = 30;
        while shift > 12_usize {
            let entry: usize = *core::ptr::<usize>(node + ((address >> shift) & 511_usize) * 8_usize);
            if (entry & 15_usize) != 1_usize { return false; }
            node = (entry >> 10_usize) << 12_usize;
            shift = shift - 9_usize;
        }
        let pointer: *usize = core::ptr::<usize>(node + ((address >> 12_usize) & 511_usize) * 8_usize);
        let expected: usize = (((display::physical_base() + page * abi::PAGE_BYTES) >> 12_usize)
            << 10_usize) | 215_usize;
        if *pointer != expected { return false; }
        *pointer = 0;
        let index: usize = (node - abi::RAM_BASE) / abi::PAGE_BYTES;
        PAGE_INFO[index].children = PAGE_INFO[index].children - 1_u32;
        return prune(id.slot, address);
    }
}
