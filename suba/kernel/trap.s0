# S-mode scalar ABI, time CSR; x27/sp preserved.
__suba_time:
csrrs x10, 3073, x0
jalr x0, 0(x1)

# SBI v0.2 TIME set_timer, absolute RV64 time. ecall does not clobber s-registers.
__suba_timer:
addi x17, x0, 84
slli x17, x17, 8
addi x17, x17, 73
slli x17, x17, 8
addi x17, x17, 77
slli x17, x17, 8
addi x17, x17, 69
addi x16, x0, 0
ecall
jalr x0, 0(x1)

__suba_activate:
csrrw x0, 384, x10
sfence.vma x0, x0
fence.i
jalr x0, 0(x1)

# sscratch=selected frame while in U, zero while in S. Trap-frame offsets match
# abi/contract.vt x1..x31 plus four CSRs. S faults never use the interrupted stack.
align 4
__suba_user_trap:
csrrw x2, 320, x2
beq x2, x0, .supervisor_fault
sd x1, 0(x2)
sd x3, 16(x2)
sd x4, 24(x2)
sd x5, 32(x2)
sd x6, 40(x2)
sd x7, 48(x2)
sd x8, 56(x2)
sd x9, 64(x2)
sd x10, 72(x2)
sd x11, 80(x2)
sd x12, 88(x2)
sd x13, 96(x2)
sd x14, 104(x2)
sd x15, 112(x2)
sd x16, 120(x2)
sd x17, 128(x2)
sd x18, 136(x2)
sd x19, 144(x2)
sd x20, 152(x2)
sd x21, 160(x2)
sd x22, 168(x2)
sd x23, 176(x2)
sd x24, 184(x2)
sd x25, 192(x2)
sd x26, 200(x2)
sd x27, 208(x2)
sd x28, 216(x2)
sd x29, 224(x2)
sd x30, 232(x2)
sd x31, 240(x2)
csrrs x5, 320, x0
sd x5, 8(x2)
csrrs x5, 321, x0
sd x5, 248(x2)
csrrs x5, 256, x0
sd x5, 256(x2)
csrrs x5, 322, x0
sd x5, 264(x2)
csrrs x5, 323, x0
sd x5, 272(x2)
csrrw x0, 320, x0
address x5, __suba_emergency
csrrw x0, 261, x5
addi x10, x2, 0
addi x2, x0, 1792
slli x2, x2, 20
addi x5, x0, 33
slli x5, x5, 12
add x2, x2, x5
addi x27, x0, 0
call __suba_trap_dispatch
jump __suba_resume

.supervisor_fault:
# Independent panic stack at 0x70024000, mapped S-only with its own guard.
addi x2, x0, 1792
slli x2, x2, 20
addi x5, x0, 36
slli x5, x5, 12
add x2, x2, x5
jump __suba_emergency

# a0 validated owned TrapFrame address; selected root already active.
# Restore only approved status: SPIE=1, SPP/SUM/MXR/FS/VS=0, UXL=64 WARL.
__suba_resume:
addi x31, x10, 0
address x5, __suba_user_trap
csrrw x0, 261, x5
csrrw x0, 320, x31
addi x5, x0, 544
csrrw x0, 260, x5
addi x5, x0, 32
csrrw x0, 256, x5
ld x5, 248(x31)
csrrw x0, 321, x5
fence.i
ld x1, 0(x31)
ld x3, 16(x31)
ld x4, 24(x31)
ld x5, 32(x31)
ld x6, 40(x31)
ld x7, 48(x31)
ld x8, 56(x31)
ld x9, 64(x31)
ld x10, 72(x31)
ld x11, 80(x31)
ld x12, 88(x31)
ld x13, 96(x31)
ld x14, 104(x31)
ld x15, 112(x31)
ld x16, 120(x31)
ld x17, 128(x31)
ld x18, 136(x31)
ld x19, 144(x31)
ld x20, 152(x31)
ld x21, 160(x31)
ld x22, 168(x31)
ld x23, 176(x31)
ld x24, 184(x31)
ld x25, 192(x31)
ld x26, 200(x31)
ld x27, 208(x31)
ld x28, 216(x31)
ld x29, 224(x31)
ld x30, 232(x31)
ld x2, 8(x31)
ld x31, 240(x31)
sret

# Serialized S-mode idle: no trap recursion, only caller-saved t0 is clobbered; stack unchanged.
__suba_idle:
addi x5, x0, 544
csrrw x0, 260, x5
wfi
jalr x0, 0(x1)

# SBI v0.2 SRST shutdown, reset_type=shutdown and reason=no-reason.
# C scalar ABI; no stack use, x27 and callee-saved registers preserved.
__suba_power_off:
addi x10, x0, 0
addi x11, x0, 0
addi x16, x0, 0
addi x17, x0, 83
slli x17, x17, 8
addi x17, x17, 82
slli x17, x17, 8
addi x17, x17, 83
slli x17, x17, 8
addi x17, x17, 84
ecall
jalr x0, 0(x1)
