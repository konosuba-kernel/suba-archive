// Serialized ABI v1: little-endian fields; never cast an external record to a struct.
// Constants are the authoritative offsets/numbers used by both kernel and user code.
module suba::abi;

pub const VERSION: u32 = 1;
pub const PAGE_BYTES: usize = 4096;
pub const RAM_BASE: usize = 0x80000000;
pub const RAM_BYTES: usize = 0x20000000;
pub const BOOT_BASE: usize = 0x80200000;
pub const BOOT_BYTES: usize = 0x200000;
pub const KERNEL_BASE: usize = 0x80400000;
pub const IMAGE_BYTES_MAX: usize = 0x4000000;
pub const USER_BASE: usize = 0x10000;
pub const USER_PAGES_BASE: usize = 0x08000000;
pub const USER_PAGES_END: usize = 0x18000000;
pub const DISPLAY_BASE: usize = 0x20000000;
pub const ARGUMENT_BASE: usize = 0x3fe00000;
pub const USER_STACK_BASE: usize = 0x3ff00000;
pub const USER_STACK_END: usize = 0x40000000;
pub const IO_BYTES_MAX: usize = 65536;

// x1..x31 occupy 31 little-endian u64 fields. x0 is implicit zero.
pub const FRAME_REGISTER_BYTES: usize = 8;
pub const FRAME_SEPC: usize = 248;
pub const FRAME_SSTATUS: usize = 256;
pub const FRAME_SCAUSE: usize = 264;
pub const FRAME_STVAL: usize = 272;
pub const FRAME_BYTES: usize = 280;
pub const FRAME_ALLOCATION_BYTES: usize = 288;

// BootInfo is 512 bytes. Reserved fields and unused reservation slots must be zero.
pub const BOOT_MAGIC: usize = 0x314f464e49425553;
pub const BOOT_INFO_BYTES: usize = 512;
pub const BOOT_INFO_MAGIC: usize = 0;
pub const BOOT_INFO_VERSION: usize = 8;
pub const BOOT_INFO_LENGTH: usize = 12;
pub const BOOT_INFO_RAM_BASE: usize = 16;
pub const BOOT_INFO_RAM_BYTES: usize = 24;
pub const BOOT_INFO_DTB_BASE: usize = 32;
pub const BOOT_INFO_DTB_BYTES: usize = 40;
pub const BOOT_INFO_KERNEL_BASE: usize = 48;
pub const BOOT_INFO_KERNEL_END: usize = 56;
pub const BOOT_INFO_SLOT: usize = 64;
pub const BOOT_INFO_CRC32: usize = 68;
pub const BOOT_INFO_RESERVATION_COUNT: usize = 72;
pub const BOOT_INFO_RESERVATIONS: usize = 128;
pub const BOOT_RESERVATION_BYTES: usize = 16;
pub const BOOT_RESERVATION_MAX: usize = 16;

// Startup page: argv entries are {offset:u32,length:u32}, relative to this page.
pub const ARGUMENT_MAGIC: usize = 0x3156475241425553;
pub const ARGUMENT_BYTES: usize = 4096;
pub const ARGUMENT_VERSION: usize = 8;
pub const ARGUMENT_LENGTH: usize = 12;
pub const ARGUMENT_COUNT: usize = 16;
pub const ARGUMENT_STDOUT: usize = 24;
pub const ARGUMENT_STDERR: usize = 32;
pub const ARGUMENT_CWD_OFFSET: usize = 40;
pub const ARGUMENT_CWD_LENGTH: usize = 44;
pub const ARGUMENT_DATA_BYTES: usize = 48;
pub const ARGUMENT_ENTRIES: usize = 64;
pub const ARGUMENT_ENTRY_BYTES: usize = 8;
pub const ARGUMENT_COUNT_MAX: usize = 64;
pub const ARGUMENT_DATA: usize = 576;

// Per-process handle: low 8 bits are slot+1, high 56 bits generation (never zero).
pub const HANDLE_SLOT_BITS: usize = 8;
pub const HANDLE_SLOT_MASK: usize = 255;
pub const HANDLE_SLOTS: usize = 64;
pub const HANDLE_GENERATION_MAX: usize = 0x00ffffffffffffff;

// ecall: a7 operation, a0..a5 inputs; a0 status, a1 value. No Linux errno ABI.
pub const OK: usize = 0;
pub const INVALID: usize = 1;
pub const BAD_HANDLE: usize = 2;
pub const DENIED: usize = 3;
pub const NOT_FOUND: usize = 4;
pub const EXISTS: usize = 5;
pub const BUSY: usize = 6;
pub const NO_MEMORY: usize = 7;
pub const NO_SPACE: usize = 8;
pub const LIMIT: usize = 9;
pub const WOULD_BLOCK: usize = 10;
pub const IO: usize = 11;
pub const UNSUPPORTED: usize = 12;
pub const CANCELLED: usize = 13;
pub const BROKEN_STREAM: usize = 14;

pub const SYS_EXIT: usize = 1;
pub const SYS_SPAWN: usize = 2;
pub const SYS_KILL_CHILD: usize = 3;
pub const SYS_COLLECT_EXIT: usize = 4;
pub const SYS_JOB_CREATE: usize = 5;
pub const SYS_JOB_FREEZE: usize = 6;
pub const SYS_JOB_END: usize = 7;
pub const SYS_ALLOC_PAGES: usize = 8;
pub const SYS_FREE_PAGES: usize = 9;
pub const SYS_FILE_OPEN: usize = 16;
pub const SYS_FILE_READ_AT: usize = 17;
pub const SYS_FILE_WRITE_AT: usize = 18;
pub const SYS_FILE_STAT: usize = 19;
pub const SYS_CLOSE: usize = 20;
pub const SYS_FILE_SYNC: usize = 21;
pub const SYS_MKDIR: usize = 24;
pub const SYS_LIST: usize = 25;
pub const SYS_UNLINK: usize = 26;
pub const SYS_REPLACE: usize = 27;
pub const SYS_STREAM_CREATE: usize = 32;
pub const SYS_STREAM_READ: usize = 33;
pub const SYS_STREAM_WRITE: usize = 34;
pub const SYS_EVENT_TRY_READ: usize = 40;
pub const SYS_EVENT_WAIT: usize = 41;
pub const SYS_WINDOW_CREATE: usize = 48;
pub const SYS_WINDOW_UPDATE: usize = 49;
pub const SYS_WINDOW_DESTROY: usize = 50;
pub const SYS_WINDOW_TRY_EVENT: usize = 51;
pub const SYS_DESKTOP_LIST: usize = 56;
pub const SYS_DESKTOP_COPY: usize = 57;
pub const SYS_DESKTOP_LAYOUT: usize = 58;
pub const SYS_DESKTOP_ROUTE: usize = 59;
pub const SYS_DESKTOP_CLOSE: usize = 60;
pub const SYS_DESKTOP_KILL: usize = 61;
pub const SYS_PUBLISH: usize = 64;
pub const SYS_SYNC_ALL: usize = 65;
pub const SYS_POWER: usize = 66;
pub const SYS_STATS: usize = 67;

// Window event: header u32 fields, window token and sequence u64, then payload.
pub const EVENT_BYTES: usize = 64;
pub const EVENT_VERSION: usize = 0;
pub const EVENT_LENGTH: usize = 4;
pub const EVENT_KIND: usize = 8;
pub const EVENT_FLAGS: usize = 12;
pub const EVENT_WINDOW: usize = 16;
pub const EVENT_SEQUENCE: usize = 24;
pub const EVENT_PAYLOAD: usize = 32;
pub const EVENT_KEY: u32 = 1;
pub const EVENT_POINTER: u32 = 2;
pub const EVENT_FOCUS: u32 = 3;
pub const EVENT_CLOSE_REQUESTED: u32 = 4;
pub const EVENT_OVERFLOW: u32 = 5;

// Disk offsets are bytes; FAT entries and first/last blocks use FS-relative 4 KiB blocks.
pub const DISK_BYTES: usize = 268435456;
pub const DISK_SECTOR_BYTES: usize = 512;
pub const BLOCK_BYTES: usize = 4096;
pub const BOOT_HEADER_BYTES: usize = 4096;
pub const BOOT_HEADER_MAGIC_VALUE: usize = 0x31544f4f42425553;
pub const BOOT_HEADER_MAGIC: usize = 0;
pub const BOOT_HEADER_VERSION: usize = 8;
pub const BOOT_HEADER_LENGTH: usize = 12;
pub const BOOT_HEADER_ACTIVE: usize = 16;
pub const BOOT_HEADER_CRC32: usize = 20;
pub const BOOT_HEADER_SLOTS: usize = 32;
pub const BOOT_SLOT_RECORD_BYTES: usize = 16;
pub const BOOT_SLOT_VALID: usize = 0;
pub const BOOT_SLOT_LENGTH: usize = 4;
pub const BOOT_SLOT_CRC32: usize = 8;
pub const SLOT_A_OFFSET: usize = 1048576;
pub const SLOT_B_OFFSET: usize = 34603008;
pub const SLOT_BYTES: usize = 33554432;
pub const FS_OFFSET: usize = 68157440;
pub const FS_BLOCKS: usize = 48896;
pub const FS_FAT_START: usize = 1;
pub const FS_FAT_BLOCKS: usize = 64;
pub const FS_NODES_START: usize = 65;
pub const FS_NODES_BLOCKS: usize = 128;
