pub const FS_SUPER_VERSION: usize = 8;
pub const FS_SUPER_BLOCK_BYTES: usize = 12;
pub const FS_SUPER_BLOCKS: usize = 16;
pub const FS_SUPER_FAT_START: usize = 20;
pub const FS_SUPER_FAT_BLOCKS: usize = 24;
pub const FS_SUPER_NODES_START: usize = 28;
pub const FS_SUPER_NODE_COUNT: usize = 32;
pub const FS_SUPER_DATA_START: usize = 36;
pub const FS_SUPER_ROOT: usize = 40;
pub const FS_SUPER_CRC32: usize = 44;
// Monotonic normal-boot identity, covered by the superblock CRC. Never wraps.
pub const FS_SUPER_BOOT_SERIAL: usize = 48;
pub const FAT_FREE: u32 = 0;
pub const FAT_END: u32 = 0xffffffff;
pub const FAT_RESERVED: u32 = 0xfffffffe;
pub const NODE_KIND: usize = 0;
