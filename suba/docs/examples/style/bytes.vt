module style::bytes;

pub enum ReadResult {
    Value(u32),
    Truncated
}

// Caller: bytes refers to live ordinary readable RAM for this call.
// This decoder does not validate a userspace address or perform MMIO.
pub unsafe fn read_u32_le(bytes: []const u8, offset: usize) -> ReadResult {
    if offset > bytes.len {
        return ReadResult::Truncated;
    }
    if bytes.len - offset < 4_usize {
        return ReadResult::Truncated;
    }

    // SAFETY: caller guarantees storage validity; checks above cover all 4 bytes.
    unsafe {
        let a = bytes[offset] as u32;
        let b = bytes[offset + 1_usize] as u32;
        let c = bytes[offset + 2_usize] as u32;
        let d = bytes[offset + 3_usize] as u32;
        return ReadResult::Value(a | (b << 8_u32) | (c << 16_u32) | (d << 24_u32));
    }
}
